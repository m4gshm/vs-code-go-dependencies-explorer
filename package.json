{
  "name": "vs-code-go-dependencies-explorer",
  "displayName": "Go dependencies explorer",
  "description": "File explorer for quickly accessing Go package resources such as .go files and so on.",
  "version": "0.0.6",
  "publisher": "m4gshm",
  "license": "MIT",
  "icon": "icon.png",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.112.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.go",
    "workspaceContains:go.mod",
    "workspaceContains:go.sum"
  ],
  "extensionDependencies": [
    "golang.go",
    "vscode.git"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m4gshm/vs-code-go-dependencies-explorer.git"
  },
  "contributes": {
    "configuration": {
      "title": "Go Dependencies Explorer",
      "properties": {
        "go.dependencies.explorer.prevent.open.git.repo": {
          "type": "string",
          "enum": [
            "ask",
            "on",
            "off"
          ],
          "default": "ask",
          "description": "Prevent opening git repositories by opening files from \"Standard Library\" or \"External Packages\"."
        },
        "go.dependencies.explorer.use.scan.cache": {
          "type": "boolean",
          "default": true,
          "description": "Cache package directory scans of the standard library and GOMODCACHE modules between refreshes. Disable to perform a full rescan on every refresh."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "go.dependencies.explorer",
          "name": "GO Dependencies",
          "when": "go.dependencies.explorer.show",
          "icon": "Go"
        }
      ]
    },
    "commands": [
      {
        "command": "go.dependencies.refresh",
        "title": "Refresh",
        "description": "Refresh the Go Dependencies.",
        "category": "Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "go.dependencies.search.in.all.directories",
        "title": "Search in Dependencies",
        "description": "Search in all dependency directories",
        "category": "Explorer",
        "icon": "$(search)"
      },
      {
        "command": "go.dependencies.go.to.package",
        "title": "Go to Package",
        "description": "Quick pick a dependency package and reveal it in the tree",
        "category": "Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "go.dependencies.copy.path",
        "title": "Copy Path"
      },
      {
        "command": "go.dependencies.copy.import.path",
        "title": "Copy Import Path",
        "category": "Explorer"
      },
      {
        "command": "go.dependencies.open.on.pkg.go.dev",
        "title": "Open on pkg.go.dev",
        "category": "Explorer"
      },
      {
        "command": "go.dependencies.open.in.integrated.terminal",
        "title": "Open in Integrated Terminal"
      },
      {
        "command": "go.dependencies.reveal.in.os.mac",
        "title": "Reveal in Finder"
      },
      {
        "command": "go.dependencies.reveal.in.os.windows",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "go.dependencies.reveal.in.os.linux",
        "title": "Reveal in Explorer View"
      },
      {
        "command": "go.dependencies.search.in.directory",
        "title": "Search in Directory"
      },
      {
        "command": "go.dependencies.open.in.workspace",
        "title": "Open in Workspace"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "go.dependencies.refresh",
          "when": "view == go.dependencies.explorer",
          "group": "navigation"
        },
        {
          "command": "go.dependencies.search.in.all.directories",
          "when": "view == go.dependencies.explorer",
          "group": "navigation"
        },
        {
          "command": "go.dependencies.go.to.package",
          "when": "view == go.dependencies.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "when": "view == 'go.dependencies.explorer'",
          "command": "go.dependencies.copy.path"
        },
        {
          "when": "view == 'go.dependencies.explorer' && viewItem == goDir",
          "command": "go.dependencies.copy.import.path"
        },
        {
          "when": "view == 'go.dependencies.explorer' && viewItem == goDir",
          "command": "go.dependencies.open.on.pkg.go.dev"
        },
        {
          "when": "view == 'go.dependencies.explorer' && viewItem == goDir",
          "command": "go.dependencies.search.in.directory"
        },
        {
          "when": "view == 'go.dependencies.explorer' && viewItem == goDir",
          "command": "go.dependencies.open.in.workspace"
        },
        {
          "when": "view == 'go.dependencies.explorer' && viewItem == goDir",
          "command": "go.dependencies.open.in.integrated.terminal"
        },
        {
          "when": "view == 'go.dependencies.explorer' && isWindows",
          "command": "go.dependencies.reveal.in.os.windows"
        },
        {
          "when": "view == 'go.dependencies.explorer' && isMac",
          "command": "go.dependencies.reveal.in.os.mac"
        },
        {
          "when": "view == 'go.dependencies.explorer' && isLinux",
          "command": "go.dependencies.reveal.in.os.linux"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rimraf ./dist ./out",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run clean && npm run check-types && npm run lint && npm run compile -- --production",
    "compile": "node esbuild.js",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch": "node esbuild.js --watch",
    "unit": "vitest run",
    "coverage": "vitest run --coverage",
    "test": "npm run unit && npm run compile && npm run compile-tests && npm run vscode-test",
    "vscode-test": "vscode-test",
    "lint": "eslint src",
    "build": "npm run test && npm run lint",
    "package": "npm run vscode:prepublish && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.112.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": ">=0.28.0",
    "eslint": "^10.2.0",
    "mocha": "^11.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^3.2.7"
  }
}
